{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "endOfLine": "lf",
  "useTabs": false,
  "bracketSpacing": false,
  "arrowParens": "always",
  "experimentalTernaries": true,
  "overrides": [
      {
        "files": "*.css",
        "options": {
          "singleQuote": false
        }
      }
    ]

}
